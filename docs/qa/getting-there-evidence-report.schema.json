{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ago-ra.life/schemas/qa/getting-there-evidence-report-v1.json",
  "title": "QA Evidence Validation Report",
  "description": "Schema for the JSON output of `scripts/qa/collect-getting-there-evidence.py --report-json`. See docs/qa/getting-there-evidence-report-json.md for prose docs.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "base_ref", "summary", "sessions"],
  "properties": {
    "schema_version": {
      "description": "Stable schema version. Bumped on breaking changes.",
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "description": "UTC timestamp when the report was generated (ISO 8601, seconds precision).",
      "type": "string",
      "format": "date-time"
    },
    "base_ref": {
      "description": "Value passed via --base-ref (e.g. \"origin/main\"), or null when unset.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "passing",
        "failing",
        "total_errors",
        "total_warnings",
        "result"
      ],
      "properties": {
        "sessions":       { "type": "integer", "minimum": 0 },
        "passing":        { "type": "integer", "minimum": 0 },
        "failing":        { "type": "integer", "minimum": 0 },
        "total_errors":   { "type": "integer", "minimum": 0 },
        "total_warnings": { "type": "integer", "minimum": 0 },
        "result":         { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "status", "exit_code", "errors", "warnings"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Repo-relative POSIX path to the session folder.",
          "pattern": "^docs/qa/evidence/[^/]+$"
        },
        "name": {
          "type": "string",
          "description": "Session folder name: YYYY-MM-DD-<7-hex>[-rN].",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{7}(-r[0-9]+)?$"
        },
        "status":    { "type": "string", "enum": ["PASS", "FAIL"] },
        "exit_code": { "type": "integer", "enum": [0, 1, 2] },
        "errors":    { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "warnings":  { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "diff": {
          "description": "Present only when base_ref is set. Git diff output scoped to the session folder, or null on diff failure.",
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "description": "status must mirror exit_code == 0.",
          "if":   { "properties": { "exit_code": { "const": 0 } } },
          "then": { "properties": { "status": { "const": "PASS" } } },
          "else": { "properties": { "status": { "const": "FAIL" } } }
        }
      ]
    }
  }
}
