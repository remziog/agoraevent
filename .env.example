# Copy to .env.local for local development. Never commit real values.

# --- Client (inlined into the browser bundle by Vite; publishable only) ---
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-id>
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google Maps JS browser key — MUST be HTTP-referrer restricted in Google Cloud
# (ago-ra.life, www.ago-ra.life, *.lovable.app) because it ships to the client.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=AIza...
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# --- Server only (never prefixed with VITE_) ---
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service role bypasses RLS: used by server functions (public events, insights,
# gamification writes) and the email queue worker. Keep it out of the client.
SUPABASE_SERVICE_ROLE_KEY=
# Lovable AI gateway (Gemini) + connector gateway (Places autocomplete)
LOVABLE_API_KEY=
# Google Maps Places API (New) server key, passed through the Lovable connector gateway
GOOGLE_MAPS_API_KEY=
