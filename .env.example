# Server-only values for local development: copy to .env.local and fill in.
# Never commit .env.local.
#
# The publishable client values (VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY,
# VITE_SUPABASE_PROJECT_ID, VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_*) already live in
# the tracked `.env`, which Lovable Cloud manages — don't edit or delete it.

SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service role bypasses RLS: used by server functions (public events, insights,
# gamification writes) and the email queue worker. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Lovable AI gateway (Gemini) + connector gateway (Places autocomplete/details)
LOVABLE_API_KEY=
# Google Maps Places API (New) server key, passed through the Lovable connector gateway
GOOGLE_MAPS_API_KEY=
# Qloo Agentic Hackathon (docs/qloo-hackathon.md). Event credential — server only,
# never VITE_-prefixed. In production this is a Lovable secret.
QLOO_API_KEY=
# Defaults to https://api.qloo.com (the host @qloo/qloo-harness uses). Hackathon credentials may
# live on https://hackathon.api.qloo.com instead: the server retries an auth failure on the other
# host automatically, but set the host from the key email here to skip the failed first try.
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional: pin the restaurant tag ids used as filter.tags (comma-separated). Otherwise
# discovered at runtime via /v2/tags.
# QLOO_RESTAURANT_TAGS=
